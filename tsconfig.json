{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "lib/**/*.ts",
    "src/cli/**/*.ts",
    "plugin-src/**/*.ts",
    "CLI_Scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "external"
  ]
}
