{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "lib/**/*.ts",
    "schema/**/*.ts",
    "bin/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "external"
  ]
}
