{
  "name": "@snl-doc/agent-toolkit",
  "version": "0.1.0",
  "description": "Portable SNL workspace Skills, CLIs, and MCP tools for AI coding agents.",
  "type": "module",
  "bin": {
    "snl-add-entry": "./bin/snl-add-entry.mjs",
    "snl-add-macro": "./bin/snl-add-macro.mjs",
    "snl-add-package": "./bin/snl-add-package.mjs",
    "snl-entry-latex": "./bin/snl-entry-latex.mjs",
    "snl-entry-ssi": "./bin/snl-entry-ssi.mjs",
    "snl-find-refs": "./bin/snl-find-refs.mjs",
    "snl-lint-entry": "./bin/snl-lint-entry.mjs",
    "snl-lint-graph": "./bin/snl-lint-graph.mjs",
    "snl-lint-package": "./bin/snl-lint-package.mjs",
    "snl-rename-id": "./bin/snl-rename-id.mjs",
    "snl-rename-style": "./bin/snl-rename-style.mjs",
    "snoogle": "./bin/snoogle.mjs",
    "snl-entity": "./bin/snl-entity.mjs",
    "snl-agent-mcp": "./dist/mcp/server.mjs"
  },
  "scripts": {
    "generate:plugin": "node scripts/generate-plugin-metadata.mjs",
    "build:plugin": "npm run generate:plugin && node scripts/build-plugin.mjs",
    "test": "tsx --test CLI_Scripts/*.test.ts",
    "lint-types": "tsc --noEmit",
    "prepack": "npm run build:plugin && npm test && npm run lint-types"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sjtu-ai4math/snl-basics": "0.2.4",
    "@types/katex": "^0.16.8",
    "fuse.js": "^7.5.0",
    "jsonc-parser": "^3.3.1",
    "katex": "0.16.47",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "~5.9.3",
    "esbuild": "0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SJTU-AI4Math/SNL-Agent-Toolkit.git"
  },
  "keywords": [
    "snl",
    "snl-doc",
    "agent",
    "cli"
  ],
  "author": "SJTU-AI4Math",
  "license": "MIT",
  "exports": {
    "./dsh": "./dist/dsh/adapter.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "Skills",
    "examples",
    "dist",
    "skills",
    "plugin",
    "plugin.json",
    "mcp.json",
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    "cordis.patch.yml",
    "AGENT.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
