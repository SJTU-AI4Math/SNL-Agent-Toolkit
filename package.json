{
  "name": "@snl-doc/agent-toolkit",
  "version": "0.1.0",
  "description": "Portable SNL workspace CLI and MCP tools for AI coding agents.",
  "type": "module",
  "bin": {
    "snl": "./dist/cli/snl.mjs",
    "snl-add-entry": "./dist/cli/snl-add-entry.mjs",
    "snl-add-macro": "./dist/cli/snl-add-macro.mjs",
    "snl-add-package": "./dist/cli/snl-add-package.mjs",
    "snl-entry-latex": "./dist/cli/snl-entry-latex.mjs",
    "snl-entry-ssi": "./dist/cli/snl-entry-ssi.mjs",
    "snl-find-refs": "./dist/cli/snl-find-refs.mjs",
    "snl-lint-entry": "./dist/cli/snl-lint-entry.mjs",
    "snl-lint-graph": "./dist/cli/snl-lint-graph.mjs",
    "snl-lint-package": "./dist/cli/snl-lint-package.mjs",
    "snl-rename-id": "./dist/cli/snl-rename-id.mjs",
    "snl-rename-style": "./dist/cli/snl-rename-style.mjs",
    "snoogle": "./dist/cli/snoogle.mjs",
    "snl-entity": "./dist/cli/snl-entity.mjs",
    "snl-agent-mcp": "./dist/mcp/server.cjs"
  },
  "scripts": {
    "generate:plugin": "node scripts/generate-plugin-metadata.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build:plugin": "npm run generate:plugin && node scripts/build-plugin.mjs",
    "test": "tsx --test --test-concurrency=4 CLI_Scripts/*.test.ts",
    "lint-types": "tsc --noEmit",
    "prepack": "npm run build:plugin && npm test && npm run lint-types"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@sjtu-ai4math/snl-basics": "0.2.4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "esbuild": "0.28.1",
    "fuse.js": "^7.5.0",
    "jsonc-parser": "^3.3.1",
    "katex": "0.16.47",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SJTU-AI4Math/SNL-Agent-Toolkit.git"
  },
  "keywords": [
    "snl",
    "snl-doc",
    "agent",
    "cli"
  ],
  "author": "SJTU-AI4Math",
  "license": "MIT",
  "exports": {
    "./dsh": "./dist/dsh/adapter.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "Skills",
    "!Skills/__deprecated__/**",
    "examples",
    "dist",
    "plugin",
    "agent-plugin",
    ".claude-plugin",
    ".agents",
    "cordis.patch.yml",
    "AGENT.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
