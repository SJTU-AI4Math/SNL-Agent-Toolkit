{
  "name": "@snl-doc/agent-toolkit",
  "version": "0.0.0",
  "description": "CLIs and agent-facing docs for authoring SNL documents in a .SNL_Doc/ workspace without the VS Code extension.",
  "type": "module",
  "private": true,
  "bin": {
    "snl-add-entry": "./bin/snl-add-entry.mjs",
    "snl-add-macro": "./bin/snl-add-macro.mjs",
    "snl-add-package": "./bin/snl-add-package.mjs",
    "snl-find-refs": "./bin/snl-find-refs.mjs",
    "snl-lint-entry": "./bin/snl-lint-entry.mjs",
    "snl-lint-graph": "./bin/snl-lint-graph.mjs",
    "snl-lint-package": "./bin/snl-lint-package.mjs",
    "snl-rename-id": "./bin/snl-rename-id.mjs",
    "snl-rename-style": "./bin/snl-rename-style.mjs",
    "snoogle": "./bin/snoogle.mjs"
  },
  "scripts": {
    "test": "tsx --test CLI_Scripts/*.test.ts",
    "lint-types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sjtu-ai4math/snl-basics": "0.1.5",
    "@types/katex": "^0.16.8",
    "fuse.js": "^7.5.0",
    "jsonc-parser": "^3.3.1",
    "katex": "0.16.47",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SJTU-AI4Math/SNL-Agent-Toolkit.git"
  },
  "keywords": [
    "snl",
    "snl-doc",
    "agent",
    "cli"
  ],
  "author": "SJTU-AI4Math",
  "license": "MIT"
}
